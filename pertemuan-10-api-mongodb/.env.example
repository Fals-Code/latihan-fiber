# Salin ke .env pada ROOT repository, lalu isi nilai lokal yang kosong.
# File ini hanya template; jangan memasukkan credential ke Git.
APP_PORT=3331
APP_NAME="Praktikum Backend Lanjut - Pertemuan 10"

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pertemuan10_test
DB_USER=REPLACE_WITH_LOCAL_DB_USER
DB_PASSWORD=
DB_SSLMODE=disable
DB_MAX_CONNS=10

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=portfolio_test

# Isi dengan nilai acak kriptografis minimal 32 karakter sebelum startup.
JWT_SECRET=
JWT_ISSUER=praktikum-backend
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
ALLOWED_ORIGINS=http://localhost:5173

# Hanya dipakai integration test; ID harus menunjuk mahasiswa sintetis yang ada.
P10_TEST_STUDENT_ID=1

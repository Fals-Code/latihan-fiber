# Template lokal. Isi nilai rahasia hanya pada .env atau environment proses.
APP_PORT=3000
APP_ROLE=api
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=praktikum_backend
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable
DB_MAX_CONNS=10
JWT_SECRET=
JWT_ISSUER=praktikum-backend
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=praktikum_backend
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
SWAGGER_ENABLED=false

# Docker Compose membaca nilai ini dari environment pemanggil.
P12_DB_PASSWORD=
P12_HTTP_PORT=18080

# Hanya untuk integration test; nama database harus berakhiran _test.
TEST_DATABASE_URL=
